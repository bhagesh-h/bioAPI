# Copy to .env and adjust. Every value below is the built-in default, so an
# empty .env — or none at all — still gives you a working container.

# ── Identity ──────────────────────────────────────────────────────────────────
PROJECT_NAME=bioAPI
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false

# ── HTTP ──────────────────────────────────────────────────────────────────────
PORT=8000
API_V1_STR=/api/v1
DOCS_ENABLED=true                # set false to hide /docs, /redoc and the schema

# Comma-separated list, or a JSON array. Use explicit origins in production:
# BACKEND_CORS_ORIGINS=https://app.example.com,https://admin.example.com
BACKEND_CORS_ORIGINS=*

# ── Security ──────────────────────────────────────────────────────────────────
# Leave unset to run open. When set, every /api/v1 route requires the
# X-API-Key header; health and metrics endpoints stay open for probes.
# API_KEY=replace-with-a-long-random-value
SECURITY_HEADERS_ENABLED=true

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_SEQUENCE_LENGTH=10000000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute    # count/second|minute|hour|day

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json for aggregators, console for humans
METRICS_ENABLED=true             # exposes Prometheus metrics at /metrics
